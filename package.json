{
  "name": "boomer-shooter",
  "version": "1.0.0",
  "description": "PROJET_CASSANDRE — prototype boomer shooter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "pnpm typecheck && pnpm test && vite build",
    "check:docs": "python3 tools/docs/check_docs_links.py docs --src src --strict",
    "check:docs:test": "python3 -m unittest discover -s tools/docs -p 'test_*.py'",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "effect": "4.0.0-rc.112",
    "howler": "2.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "xstate": "5.32.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@types/howler": "2.2.13",
    "@types/node": "^22.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
