{
  "name": "boomer-shooter",
  "version": "2.1.0",
  "description": "PROJET_CASSANDRE — prototype boomer shooter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benjiGir/projet-cassandre.git"
  },
  "homepage": "https://benjigir.github.io/projet-cassandre/",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && vite build",
    "probe": "node tools/probe/probe.mjs",
    "economy": "node tools/economy/releve.mjs",
    "verify": "node tools/verify.mjs",
    "check:docs": "python3 tools/docs/check_docs_links.py docs --src src --strict --allow-empty-drafts",
    "check:docs:test": "python3 -m unittest discover -s tools/docs -p 'test_*.py'",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test vite.config.ts vitest.config.ts",
    "lint:fix": "oxlint --fix src test vite.config.ts vitest.config.ts",
    "format": "oxfmt --write src test vite.config.ts vitest.config.ts",
    "format:check": "oxfmt --check src test vite.config.ts vitest.config.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "effect": "4.0.5",
    "fx-audio": "https://github.com/benjiGir/fx-audio/releases/download/v1.0.0/fx-audio-1.0.0.tgz",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1",
    "xstate": "5.32.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.5",
    "@types/node": "^22.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "26.1.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright-core": "^1.63.0",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
